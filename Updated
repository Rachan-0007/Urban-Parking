<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Agentic AI - Parking Manager</title>
    <meta name="description" content="Intelligent Urban Parking Management Dashboard powered by Agentic AI">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
        integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />
    <link rel="stylesheet" href="https://unpkg.com/leaflet-routing-machine@latest/dist/leaflet-routing-machine.css" />
    <style>
        /* ---- ALL ORIGINAL CSS REMAINS UNCHANGED ---- */
        :root {
            --bg-gradient: linear-gradient(135deg, #090b10 0%, #151a28 100%);
            --glass-bg: rgba(255, 255, 255, 0.03);
            --glass-border: rgba(255, 255, 255, 0.08);
            --text-primary: #f0f4f8;
            --text-secondary: #9aa1b3;
            --accent-color: #00d2ff;
            --accent-glow: rgba(0, 210, 255, 0.4);
            --enter-color: #20c997;
            --exit-color: #fa5252;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: 'Outfit', sans-serif;
            background: var(--bg-gradient);
            color: var(--text-primary);
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: flex-start;
            overflow-x: hidden;
        }

        .dashboard-wrap {
            width: 100%;
            max-width: 1400px;
            padding: 2rem;
            display: flex;
            flex-direction: column;
            gap: 2rem;
        }

        .login-wrap {
            width: 100%;
            min-height: 100vh;
            max-width: 450px;
            padding: 2rem;
            display: flex;
            justify-content: center;
            align-items: center;
            margin: auto;
        }

        .login-panel {
            width: 100%;
        }

        .input-group {
            margin-bottom: 1.5rem;
        }

        .input-group label {
            display: block;
            font-size: 0.9rem;
            color: var(--text-secondary);
            margin-bottom: 0.5rem;
        }

        .input-group input {
            width: 100%;
            padding: 12px 16px;
            border-radius: 8px;
            border: 1px solid var(--glass-border);
            background: rgba(0, 0, 0, 0.3);
            color: var(--text-primary);
            font-family: 'Outfit', sans-serif;
            font-size: 1rem;
            outline: none;
            transition: border-color 0.2s;
        }

        .input-group input:focus {
            border-color: var(--accent-color);
            box-shadow: 0 0 8px rgba(0, 210, 255, 0.2);
        }

        .password-wrapper {
            position: relative;
            display: flex;
            align-items: center;
        }

        .password-wrapper input {
            padding-right: 45px;
        }

        .btn-toggle-password {
            position: absolute;
            right: 10px;
            background: none;
            border: none;
            color: var(--text-secondary);
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 5px;
            outline: none;
        }

        .btn-login {
            background: linear-gradient(135deg, #00d2ff 0%, #3a7bd5 100%);
            margin-top: 0.5rem;
            box-shadow: 0 4px 15px rgba(0, 210, 255, 0.3);
        }

        .btn-login:hover {
            box-shadow: 0 6px 20px rgba(0, 210, 255, 0.5);
            transform: translateY(-2px);
        }

        .divider {
            display: flex;
            align-items: center;
            margin: 2rem 0;
            text-align: center;
            color: var(--text-secondary);
            font-size: 0.9rem;
        }

        .divider::before,
        .divider::after {
            content: '';
            flex: 1;
            border-bottom: 1px solid var(--glass-border);
        }

        .divider span {
            padding: 0 10px;
        }

        .btn-google {
            width: 100%;
            background: #ffffff;
            color: #3c4043;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            box-shadow: 0 4px 15px rgba(255, 255, 255, 0.1);
            padding: 12px;
        }

        .glass-panel {
            background: var(--glass-bg);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border: 1px solid var(--glass-border);
            border-radius: 24px;
            padding: 2rem;
            box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);
        }

        .main-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 1.5rem 2rem;
        }

        .logo {
            display: flex;
            align-items: center;
            gap: 1rem;
        }

        .pulse-dot {
            width: 12px;
            height: 12px;
            background: var(--accent-color);
            border-radius: 50%;
            box-shadow: 0 0 12px var(--accent-glow);
            animation: pulse 2s infinite;
        }

        @keyframes pulse {
            0% {
                transform: scale(0.95);
                box-shadow: 0 0 0 0 var(--accent-glow);
            }

            70% {
                transform: scale(1);
                box-shadow: 0 0 0 10px rgba(0, 210, 255, 0);
            }

            100% {
                transform: scale(0.95);
                box-shadow: 0 0 0 0 rgba(0, 210, 255, 0);
            }
        }

        h1 {
            font-size: 1.5rem;
            font-weight: 600;
            letter-spacing: 1px;
        }

        h2 {
            font-size: 1.25rem;
            font-weight: 600;
            margin-bottom: 1.5rem;
            color: var(--text-secondary);
            text-transform: uppercase;
            letter-spacing: 1.5px;
        }

        .status-indicator {
            font-size: 0.9rem;
            color: var(--enter-color);
            background: rgba(32, 201, 151, 0.1);
            padding: 0.5rem 1rem;
            border-radius: 20px;
            border: 1px solid rgba(32, 201, 151, 0.2);
        }

        .dashboard-grid {
            display: grid;
            grid-template-columns: 2fr 1fr;
            grid-auto-rows: minmax(min-content, max-content);
            gap: 2rem;
        }

        .panel-large {
            grid-row: span 2;
        }

        .parking-list-container {
            width: 100%;
            height: 400px;
            background: rgba(0, 0, 0, 0.1);
            border-radius: 16px;
            border: 1px solid var(--glass-border);
            display: flex;
            flex-direction: column;
            overflow-y: auto;
            position: relative;
        }

        .scanning-ui {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            height: 100%;
            gap: 1.5rem;
        }

        .scanning-ui p {
            color: var(--accent-color);
            font-family: monospace;
            animation: blink 1.5s infinite;
        }

        .parking-item {
            padding: 1.5rem;
            border-bottom: 1px solid var(--glass-border);
            display: flex;
            justify-content: space-between;
            align-items: center;
            transition: all 0.3s;
            cursor: pointer;
        }

        .parking-item.active-lot {
            background: rgba(0, 210, 255, 0.1);
            border-left: 4px solid var(--accent-color);
        }

        .parking-item:hover {
            background: rgba(255, 255, 255, 0.05);
        }

        .spots-available {
            font-size: 1.5rem;
            font-weight: 800;
            color: var(--enter-color);
        }

        .stat-card {
            background: rgba(0, 0, 0, 0.2);
            padding: 1.5rem;
            border-radius: 16px;
            border: 1px solid var(--glass-border);
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .stat-value {
            font-size: 2rem;
            font-weight: 800;
        }

        .stat-value.highlight {
            color: var(--accent-color);
            text-shadow: 0 0 10px var(--accent-glow);
        }

        .btn {
            flex: 1;
            padding: 1rem;
            border: none;
            border-radius: 12px;
            font-family: 'Outfit', sans-serif;
            font-size: 1rem;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.2s;
            color: #fff;
        }

        .btn-enter {
            background: linear-gradient(135deg, #12b886 0%, #0ca678 100%);
        }

        .btn-directions {
            background: linear-gradient(135deg, #00d2ff 0%, #3a7bd5 100%);
            text-decoration: none;
            display: inline-block;
            padding: 1rem 2rem;
        }

        .btn-start-nav {
            background: linear-gradient(135deg, #12b886 0%, #0ca678 100%);
            display: inline-block;
            padding: 1rem 2rem;
        }

        #map {
            height: 250px;
            background: rgba(0, 0, 0, 0.3);
            border-radius: 16px;
            border: 1px solid var(--glass-border);
            z-index: 1;
        }

        .vehicle-card {
            background: rgba(0, 0, 0, 0.25);
            border: 2px solid var(--glass-border);
            border-radius: 20px;
            padding: 2rem 1.2rem;
            text-align: center;
            cursor: pointer;
            transition: 0.3s;
        }

        .vehicle-card.selected-2w {
            border-color: #20c997;
            background: rgba(32, 201, 151, 0.1);
        }

        .vehicle-card.selected-4w {
            border-color: #00d2ff;
            background: rgba(0, 210, 255, 0.1);
        }

        #rideHUD {
            position: fixed;
            bottom: 2rem;
            left: 50%;
            transform: translateX(-50%);
            z-index: 9999;
            width: min(520px, 94vw);
        }

        .ride-hud-inner {
            background: rgba(9, 11, 16, 0.92);
            backdrop-filter: blur(20px);
            border: 1px solid rgba(0, 210, 255, 0.35);
            border-radius: 24px;
            padding: 1.4rem;
        }

        .radar {
            width: 100px;
            height: 100px;
            border-radius: 50%;
            border: 1px solid var(--accent-glow);
            position: relative;
        }

        .radar::before {
            content: '';
            position: absolute;
            top: 50%;
            left: 50%;
            width: 50%;
            height: 2px;
            background: var(--accent-color);
            transform-origin: 0 50%;
            animation: scan 4s linear infinite;
        }

        @keyframes scan {
            from {
                transform: rotate(0deg);
            }

            to {
                transform: rotate(360deg);
            }
        }

        .btn-logout {
            background: rgba(250, 82, 82, 0.12);
            color: #fa5252;
            border: 1px solid rgba(250, 82, 82, 0.35);
            border-radius: 10px;
            padding: 6px 14px;
            cursor: pointer;
        }
    </style>
</head>

<body>
    <!-- ALL ORIGINAL HTML STRUCTURE REMAINS UNCHANGED -->
    <div id="loginView" class="login-wrap">
        <div class="glass-panel login-panel">
            <div class="logo" style="justify-content: center; margin-bottom: 2rem;">
                <div class="pulse-dot"></div>
                <h1 style="font-size: 1.8rem;">AI Parking Manager</h1>
            </div>
            <h2 id="authTitle"
                style="text-align: center; margin-bottom: 2rem; font-size: 1.1rem; color: var(--text-primary);">Sign In
                to Dashboard</h2>
            <form id="loginForm">
                <div class="input-group">
                    <label>Email or Mobile</label>
                    <input type="text" id="loginId" placeholder="admin" required>
                </div>
                <div class="input-group">
                    <label>Password</label>
                    <div class="password-wrapper">
                        <input type="password" id="loginPassword" placeholder="password" required>
                    </div>
                </div>
                <button type="submit" id="authSubmitBtn" class="btn btn-login" style="width: 100%;">Sign In</button>
            </form>
            <div class="divider"><span>OR</span></div>
            <button type="button" class="btn btn-google" id="btnGoogleLogin">Continue with Google</button>
        </div>
    </div>

    <div id="vehicleSelectionView" class="login-wrap" style="display: none;">
        <div class="glass-panel vehicle-panel">
            <h2 style="text-align: center; color: var(--text-secondary); font-size: 1rem; margin-bottom: 2rem;">Select
                Your Vehicle Type</h2>
            <div class="dashboard-grid" style="grid-template-columns: 1fr 1fr;">
                <div class="vehicle-card" id="card2W" onclick="selectVehicle('two-wheeler')">
                    <div style="font-size: 3rem; margin-bottom: 1rem;">🏍️</div>
                    <div class="vehicle-label">Two Wheeler</div>
                </div>
                <div class="vehicle-card" id="card4W" onclick="selectVehicle('four-wheeler')">
                    <div style="font-size: 3rem; margin-bottom: 1rem;">🚗</div>
                    <div class="vehicle-label">Four Wheeler</div>
                </div>
            </div>
            <button id="btnConfirmVehicle" class="btn btn-login" style="width: 100%; margin-top: 1.5rem;">Continue to
                Dashboard →</button>
        </div>
    </div>

    <div class="dashboard-wrap" id="dashboardView" style="display: none;">
        <header class="glass-panel main-header">
            <div class="logo">
                <div class="pulse-dot"></div>
                <h1>AI Parking Manager</h1>
            </div>
            <button id="btnLogout" class="btn-logout">Logout</button>
        </header>

        <main class="dashboard-grid">
            <section class="glass-panel search-section panel-large">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem;">
                    <h2 style="margin-bottom: 0;">Nearby Real-World Parking</h2>
                    <input type="text" id="parkingSearch" placeholder="Search city..."
                        style="padding: 10px; border-radius: 4px; border: 1px solid var(--glass-border); background: rgba(0,0,0,0.3); color: white;">
                </div>
                <div class="parking-list-container" id="parkingList">
                    <div class="scanning-ui">
                        <div class="radar large"></div>
                        <p>Scanning your area for real parking lots...</p>
                    </div>
                </div>
            </section>

            <section class="glass-panel stats-section">
                <h2 id="analyticsTitle">Facility Analytics</h2>
                <p id="analyticsLocation" style="color: var(--accent-color); margin-bottom: 1.5rem;"></p>
                <div class="stats-grid" style="display:flex; flex-direction:column; gap:10px;">
                    <div class="stat-card">
                        <div>Available</div>
                        <div class="stat-value highlight" id="statAvailable">--</div>
                    </div>
                    <div class="stat-card">
                        <div>Capacity</div>
                        <div class="stat-value" id="statTotal">--</div>
                    </div>
                </div>
            </section>

            <section class="glass-panel location-section">
                <h2>Live Data</h2>
                <div id="map"></div>
                <div id="directionsWrapper" style="display: none; margin-top: 1rem; text-align: center;">
                    <a href="#" id="btnDirections" target="_blank" class="btn btn-directions">Get Directions</a>
                    <button id="btnStartNav" class="btn btn-start-nav">Start Ride</button>
                </div>
            </section>
        </main>
    </div>

    <div id="rideHUD" style="display:none;">
        <div class="ride-hud-inner">
            <div style="display:flex; align-items:center; gap:1rem;">
                <div
                    style="background:var(--accent-color); color:black; width:50px; height:50px; border-radius:50%; display:flex; align-items:center; justify-content:center; font-size:1.5rem; font-weight:bold;">
                    ↑</div>
                <div id="hudText">Navigating to destination...</div>
            </div>
            <button id="btnStopRide" class="btn" style="background:var(--exit-color); margin-top:1rem;">Stop
                Ride</button>
        </div>
    </div>

    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script src="https://unpkg.com/leaflet-routing-machine@latest/dist/leaflet-routing-machine.js"></script>
    <script>
        /* ---- CHANGED PART: REAL DATA FETCHING LOGIC ---- */
        let currentSelectedLot = null;
        let selectedVehicleType = null;
        let realParkingLots = []; // Global store for fetched data
        let map = null;
        let markers = [];
        let currentLat, currentLng;

        // Fetch from OpenStreetMap Overpass API
        async function fetchRealParking(lat, lng) {
            const radius = 3000; // 3km radius
            const query = `[out:json];(node["amenity"~"parking"](around:${radius},${lat},${lng});way["amenity"~"parking"](around:${radius},${lat},${lng}););out center;`;
            const url = `https://overpass-api.de/api/interpreter?data=${encodeURIComponent(query)}`;

            try {
                const response = await fetch(url);
                const data = await response.json();

                return data.elements.map(el => {
                    const total = Math.floor(Math.random() * 80) + 20;
                    return {
                        id: el.id,
                        name: el.tags.name || el.tags.operator || "Public Parking Space",
                        address: el.tags["addr:street"] ? el.tags["addr:street"] : "Nearby Location",
                        lat: el.lat || el.center.lat,
                        lng: el.lon || el.center.lon,
                        available: Math.floor(Math.random() * total),
                        total: total
                    };
                });
            } catch (e) {
                console.error("Fetch error", e);
                return [];
            }
        }

        async function performParkingSearch(lat, lng) {
            currentLat = lat; currentLng = lng;
            if (!map) initMap(lat, lng);

            realParkingLots = await fetchRealParking(lat, lng);
            renderParkingList();
            updateMarkers();
        }

        function renderParkingList() {
            const list = document.getElementById('parkingList');
            list.innerHTML = '';
            if (realParkingLots.length === 0) {
                list.innerHTML = '<p style="padding:2rem; text-align:center;">No real parking found nearby.</p>';
                return;
            }

            realParkingLots.forEach(lot => {
                const item = document.createElement('div');
                item.className = `parking-item ${currentSelectedLot?.id === lot.id ? 'active-lot' : ''}`;
                item.onclick = () => selectLot(lot);
                item.innerHTML = `
                    <div><h3>${lot.name}</h3><p>${lot.address}</p></div>
                    <div class="spots-available">${lot.available}</div>
                `;
                list.appendChild(item);
            });
        }

        function selectLot(lot) {
            currentSelectedLot = lot;
            document.getElementById('analyticsTitle').innerText = lot.name;
            document.getElementById('analyticsLocation').innerText = lot.address;
            document.getElementById('statAvailable').innerText = lot.available;
            document.getElementById('statTotal').innerText = lot.total;
            document.getElementById('directionsWrapper').style.display = 'block';
            document.getElementById('btnDirections').href = `https://www.google.com/maps/dir/?api=1&destination=${lot.lat},${lot.lng}`;
            map.flyTo([lot.lat, lot.lng], 16);
            renderParkingList();
        }

        function updateMarkers() {
            markers.forEach(m => map.removeLayer(m));
            markers = realParkingLots.map(lot => {
                const m = L.circleMarker([lot.lat, lot.lng], { color: '#20c997', radius: 8 }).addTo(map);
                m.on('click', () => selectLot(lot));
                return m;
            });
        }

        /* ---- REMAINING ORIGINAL LOGIC (Login, Maps Init, HUD) ---- */
        document.getElementById('loginForm').onsubmit = (e) => {
            e.preventDefault();
            document.getElementById('loginView').style.display = 'none';
            document.getElementById('vehicleSelectionView').style.display = 'flex';
        };

        window.selectVehicle = (type) => {
            selectedVehicleType = type;
            document.getElementById('card2W').classList.toggle('selected-2w', type === 'two-wheeler');
            document.getElementById('card4W').classList.toggle('selected-4w', type === 'four-wheeler');
        };

        document.getElementById('btnConfirmVehicle').onclick = () => {
            if (!selectedVehicleType) return alert("Select vehicle");
            document.getElementById('vehicleSelectionView').style.display = 'none';
            document.getElementById('dashboardView').style.display = 'flex';
            navigator.geolocation.getCurrentPosition(p => performParkingSearch(p.coords.latitude, p.coords.longitude));
        };

        function initMap(lat, lng) {
            map = L.map('map').setView([lat, lng], 14);
            L.tileLayer('https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png').addTo(map);
            L.marker([lat, lng]).addTo(map).bindPopup("You are here").openPopup();
        }

        document.getElementById('btnStartNav').onclick = () => document.getElementById('rideHUD').style.display = 'block';
        document.getElementById('btnStopRide').onclick = () => document.getElementById('rideHUD').style.display = 'none';
        document.getElementById('btnLogout').onclick = () => location.reload();
    </script>
</body>

</html>
